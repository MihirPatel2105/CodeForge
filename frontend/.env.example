# Local development uses http://localhost:8000 when this is unset.
# Production: set these only on the Next.js server, never NEXT_PUBLIC_*.
CODEFORGE_API_INTERNAL_URL=http://localhost:8000
# Set the exact HTTPS frontend origin only in production. Development uses its
# current port automatically, including when Next.js moves from 3000 to 3001.
# CODEFORGE_FRONTEND_ORIGIN=https://app.example.com
# Production: the same random 32+ character value as backend PROXY_IP_SECRET.
CODEFORGE_PROXY_IP_SECRET=
