# Copy to deployment.env on the backend host; never commit the filled file.
# Use a URL-safe alphanumeric database password (it is embedded in DATABASE_URL).
LANGFUSE_DB_PASSWORD=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
# Keep Langfuse private via an SSH tunnel unless you set up separate HTTPS access.
LANGFUSE_URL=http://localhost:3000
