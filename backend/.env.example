# Local Docker Mongo (the docker-compose `mongo` service) by default. Swap for an
# Atlas M0 free-tier connection string to run against a hosted cluster instead —
# both are sanctioned in CLAUDE.md §3. Atlas form:
#   mongodb+srv://<db-user>:<password>@<cluster-name>.<id>.mongodb.net/?appName=<cluster-name>
MONGO_URI=mongodb://localhost:27017
MONGO_DB=codeforge
JWT_SECRET=change-me

GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# --- Email verification (sign-up OTP) ---
# SMTP_USER is the address the codes are sent from; SMTP_PASSWORD is a 16-character
# Google App Password (Security -> 2-Step Verification -> App passwords), not the
# account password. Leave both blank to run with verification switched off.
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM_NAME=CodeForge

OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
