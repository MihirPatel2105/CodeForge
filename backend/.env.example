# Local Docker Mongo (the docker-compose `mongo` service) by default. If you run
# uvicorn directly on the host, use mongodb://localhost:27017 instead. For deployment,
# use an Atlas M0 free-tier connection string (see docs/DEPLOYMENT.md). Atlas form:
#   mongodb+srv://<db-user>:<password>@<cluster-name>.<id>.mongodb.net/?appName=<cluster-name>
MONGO_URI=mongodb://mongo:27017
MONGO_DB=codeforge
JWT_SECRET=change-me

# Production: set both to the same HTTPS frontend origin (no trailing slash).
# CORS_ORIGINS is a JSON array; add only frontend origins you control.
# APP_BASE_URL also sets email links and the passkey relying-party domain.
# CORS_ORIGINS=["https://your-frontend.example"]
# APP_BASE_URL=https://your-frontend.example

# Existing verified account allowed to open the read-only /admin control centre.
# Leave blank to disable admin access entirely.
ADMIN_EMAIL=
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
ADMIN_FAILURE_ALERT_PERCENT=25
ADMIN_FAILURE_ALERT_MIN_RUNS=5

GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# --- Email verification (sign-up OTP) ---
# SMTP_USER is the address the codes are sent from; SMTP_PASSWORD is a 16-character
# Google App Password (Security -> 2-Step Verification -> App passwords), not the
# account password. Leave both blank to run with verification switched off.
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM_NAME=CodeForge

OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
